# Drawing needs no environment variables.
#
# Everything runs in the browser: there is no database, no API key and no
# server-side state. This file exists so the requirement is documented rather
# than left ambiguous - copy it to .env.local only if you add your own config.
#
# Optional, local development only:
# PORT=3049

# Optional - only if this app posts notes to the local Stickies app.
STICKIES_API_BASE=http://localhost:4444
STICKIES_TOKEN=
